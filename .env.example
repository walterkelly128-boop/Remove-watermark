# RCouyi / OpenAI-compatible image API
# Do NOT commit your real key.
RC_API_KEY=YOUR_RCOUYI_API_KEY_HERE
RC_API_BASE_URL=https://api.rcouyi.com/v1

# Use the exact image-capable model names shown in your RCouyi account.
RC_GEMINI_MODEL=YOUR_GEMINI_IMAGE_MODEL
RC_OPENAI_MODEL=YOUR_OPENAI_IMAGE_MODEL
RC_API_TIMEOUT=180

# Account / credit system
FREE_CREDITS=5
GUEST_CREDITS=5
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
ACCOUNT_DB_PATH=/app/data/accounts.db

# Guest quota security: keep this value stable across restarts.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GUEST_IP_SALT=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Session security: 12h absolute lifetime, 2h idle timeout.
SESSION_TTL_MINUTES=720
SESSION_IDLE_MINUTES=120

# Set to 1 only when a trusted reverse proxy safely passes X-Forwarded-For.
TRUST_PROXY=0

# Admin TOTP 2FA. Put the Base32 secret only in the real .env, never in GitHub.
ADMIN_TOTP_SECRET=
ADMIN_TOTP_REQUIRED=0

# Manual recharge packages: credits:price, separated by commas.
RECHARGE_PACKAGES=10:5,50:20,100:35

# Optional text shown on the recharge page. Do not put private payment credentials in GitHub.
RECHARGE_PAYMENT_INSTRUCTIONS=请先提交充值申请，管理员确认收款后会手动审核并增加额度。
