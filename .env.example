# RCouyi / OpenAI-compatible image API
# Do NOT commit your real key.
RC_API_KEY=YOUR_RCOUYI_API_KEY_HERE
RC_API_BASE_URL=https://api.rcouyi.com/v1

# Use the exact image-capable model names shown in your RCouyi account.
RC_GEMINI_MODEL=YOUR_GEMINI_IMAGE_MODEL
RC_OPENAI_MODEL=YOUR_OPENAI_IMAGE_MODEL
RC_API_TIMEOUT=180

# Account / credit system
FREE_CREDITS=5
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
ACCOUNT_DB_PATH=/app/data/accounts.db
